# Copy this file to .env and fill in your real values.
#
# The number that RECEIVES the reminders (your personal WhatsApp).
# Format: <countrycode><number>@c.us — no +, spaces or dashes.
# Example: 15551234567@c.us for US +1 (555) 123-4567
#
# Two setups work:
#   • Scan the QR with this same number → reminders arrive in your
#     "Message yourself" chat.
#   • Scan the QR with a SECOND number (recommended) → the bot messages you
#     from that number, so you get normal notifications.
MY_WHATSAPP_NUMBER=
