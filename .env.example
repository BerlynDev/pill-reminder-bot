# Copy this file to .env and fill in your real values. Never commit .env.

# From @BotFather in Telegram (/newbot). Anyone with this token controls your bot.
TELEGRAM_BOT_TOKEN=

# Your chat with the bot. Leave empty on first run, press Start in the bot
# chat, and the bot replies with the value to put here.
TELEGRAM_CHAT_ID=

# Language the bot speaks in Telegram: es (español, default) or en (English)
BOT_LANGUAGE=es
