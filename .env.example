# Copy this file to .env and fill in your real values. Never commit .env.

# From @BotFather in Telegram (/newbot). Anyone with this token controls your bot.
TELEGRAM_BOT_TOKEN=

# Only for the older single-person pills.json format ({ "pills": [...] }).
# With "people" in pills.json, each person's chatId goes there instead.
# Leave empty on first run: press Start in the bot chat and it replies
# with your chat ID.
TELEGRAM_CHAT_ID=

# Default language (people can override it in pills.json): es (default) or en
BOT_LANGUAGE=es
